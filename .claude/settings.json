{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/lint-on-edit.js",
            "timeout": 60,
            "statusMessage": "Linting and type-checking..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-destructive-bash.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/test-before-commit.js",
            "if": "Bash(git commit*)",
            "timeout": 60,
            "statusMessage": "Running tests before commit..."
          }
        ]
      }
    ]
  }
}
